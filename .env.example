# Backend runtime
# Local development (SQLite):
DATABASE_URL=sqlite:///./supplier_intelligence.db
# Production alternative (PostgreSQL; replace the line above in host configuration):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&channel_binding=require
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI explanation provider; mock requires no external credentials
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
